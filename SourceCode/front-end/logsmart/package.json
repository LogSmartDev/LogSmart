{
	"name": "logsmart",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"local": "PUBLIC_API_URL=http://localhost:6767 vite dev",
		"dev": "bun format --log-level error && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"logs": "wrangler pages deployment tail --project-name=logsmart",
		"deploy": "svelte-kit sync && bun run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=logsmart",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:api": "openapi-typescript openapi.json -o src/lib/api-types.d.ts && bun format",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "1.54.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^20.19.43",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^16.5.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^7.3.5",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@neodrag/svelte": "^2.3.3",
		"@simplewebauthn/browser": "^13.3.0",
		"@types/pg": "^8.20.0",
		"cropperjs": "^2.1.1",
		"openapi-fetch": "^0.15.2",
		"pg": "^8.22.0"
	}
}
